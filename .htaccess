# =====================================================================
# CPANEL APACHE DIRECTORY REWRITE
# =====================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Se a requisição é para um arquivo ou diretório existente em dist, sirva de dist
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule ^(.*)$ dist/$1 [QSA,L]

  # Fallback simples de SPA
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>
