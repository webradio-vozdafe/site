# =====================================================================
# REDIRECIONAMENTO AUTOMÁTICO PARA CPANEL SE O PROJETO FOR ENVIADO INTEIRO
# =====================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Se a pasta 'dist' existir na raiz do servidor web
  RewriteCond %{DOCUMENT_ROOT}/dist -d

  # Ignora se a requisição já for para a pasta dist
  RewriteCond %{REQUEST_URI} ^/dist/ [NC]
  RewriteRule ^ - [L]

  # Se o arquivo solicitado existir dentro de dist, serve de dist
  RewriteCond %{DOCUMENT_ROOT}/dist/%{REQUEST_URI} -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # Se o diretório solicitado existir dentro de dist, serve de dist
  RewriteCond %{DOCUMENT_ROOT}/dist/%{REQUEST_URI} -d
  RewriteRule ^(.*)$ dist/$1 [L]

  # Fallback de SPA para dist/index.html
  RewriteRule ^(.*)$ dist/index.html [L]
</IfModule>

# Compressão GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Cabeçalhos CORS & Segurança
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
